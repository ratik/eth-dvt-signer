# Pinned versions of the Ethereum integration environment (docs/ethereum-devnet.md).
# kurtosis/network.yaml pins the client images too; keep both in step.
KURTOSIS_VERSION=1.22.2
KURTOSIS_SHA256=789be2d263e3ba731b8bc99e7bf2162f58efa8d085e481f2aecfcccbe1b46734
ETHEREUM_PACKAGE=github.com/ethpandaops/ethereum-package@6.1.0
LIGHTHOUSE_IMAGE=sigp/lighthouse:v8.3.2
# Validator clients other than Lighthouse's, for IT_VC=teku|nimbus (docs/ethereum-devnet.md).
TEKU_IMAGE=consensys/teku:26.10.3
NIMBUS_VC_IMAGE=statusim/nimbus-validator-client:multiarch-v26.10.2
GETH_IMAGE=ethereum/client-go:v1.17.10
FOUNDRY_IMAGE=ghcr.io/foundry-rs/foundry:v1.8.6
RUST_IMAGE=rust:1.99.1-bookworm
# Fuzzing only (`env.sh fuzz`, the `fuzz-smoke` step): libFuzzer and its sanitizers need a nightly.
FUZZ_TOOLCHAIN=nightly-2026-10-25
CARGO_FUZZ_VERSION=0.13.2
DIND_IMAGE=docker:29.9.2-dind
RUNTIME_IMAGE=debian:bookworm-slim
