# Pinned inputs of the node's closed VM image and its QEMU harness (integration/tee/README.md).
# The node binary is built with RUST_IMAGE from integration/ethereum/config/versions.env.

# The tools container (mkosi, systemd-repart, ukify, QEMU, OVMF): Debian trixie, by digest.
TEE_TOOLS_BASE=debian:trixie-20261027-slim@sha256:1e1a22175fbf1b32157ddaf0219e1db4e5401fab2b94ed285add64d18587cd2d
TEE_MKOSI_VERSION=25.3-7

# One Debian snapshot for the tools (trixie) and the image (bookworm, its kernel from
# bookworm-backports). Its time is the image's SOURCE_DATE_EPOCH.
TEE_SNAPSHOT=20261101T000000Z
TEE_SOURCE_DATE_EPOCH=1793491200
