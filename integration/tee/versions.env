# Pinned inputs of the node's closed VM image and its QEMU harness (integration/tee/README.md).
# The node binary is built with RUST_IMAGE from integration/ethereum/config/versions.env.

# The tools container (mkosi, systemd-repart, ukify, QEMU, OVMF): Debian trixie, by digest.
TEE_TOOLS_BASE=debian:trixie-20261027-slim@sha256:1e1a22175fbf1b32157ddaf0219e1db4e5401fab2b94ed285add64d18587cd2d
TEE_MKOSI_VERSION=25.3-7

# One Debian snapshot for the tools and the image (both trixie; the image's kernel from
# trixie-backports). Its time is the image's SOURCE_DATE_EPOCH.
TEE_SNAPSHOT=20261101T000000Z
TEE_SOURCE_DATE_EPOCH=1793491200

# go-tpm-tools' gotpm (the attestation token on a GCE TDX VM), at tag v0.4.11 (2026-10-09): the
# `cmd` module of that tree, which needs Go 1.26 and replaces go-tpm-tools with `../` (its own
# tag, cmd/v0.4.5, predates TDX tokens), built in the tools image with Debian's Go of that version.
TEE_GOTPM_REPOSITORY=https://github.com/google/go-tpm-tools.git
TEE_GOTPM_COMMIT=829ec3137784ea87185b4fda5e34d2d2ae59b749
TEE_GO_PACKAGE=golang-1.26-go/trixie-backports

# SEV-SNP (docs/tee.md, "The sev-snp platform"). The guest firmware: OVMF's AmdSev build (it checks
# the kernel, initrd and command line against the hashes QEMU puts in the launch measurement,
# `kernel-hashes=on`). Debian builds no AmdSev OVMF, so it is Ubuntu's ovmf-amdsev package, by
# its Launchpad librarian URL and SHA-256; the firmware file's SHA-256 is checked too.
TEE_OVMF_AMDSEV_URL=https://launchpadlibrarian.net/878512645/ovmf-amdsev_2025.11-3ubuntu7.3_all.deb
TEE_OVMF_AMDSEV_DEB_SHA256=f2a54db678d98ce1a5ac27155cb037cbf6e3efc918d11a35af1ca4606a290d29
TEE_OVMF_AMDSEV_SHA256=ac27e626b097cf6f9eae09b79fc87fc2d3fb6e99c8d97b27f0603993c06a28bb
# virtee's sev-snp-measure (Apache-2.0): the launch measurement of a direct boot, from the firmware,
# kernel, initrd, command line, vCPU count and type. The wheel from PyPI, by its SHA-256.
TEE_SNP_MEASURE_URL=https://files.pythonhosted.org/packages/12/96/5b673738d1f973700369d9e80c1c32937d230acef721141e532891441213/sev_snp_measure-0.0.13-py3-none-any.whl
TEE_SNP_MEASURE_SHA256=feda1aebe69dcbf38e9c636ed1d082bb7dc741fc6969f197d39faddb72b2762d
# The SEV-SNP launch the measurement is computed for (integration/tee/snp/launch.sh launches it so):
# vCPUs and QEMU's CPU model. Another count or model gives another measurement.
TEE_SNP_VCPUS=4
TEE_SNP_VCPU_TYPE=EPYC-v4
