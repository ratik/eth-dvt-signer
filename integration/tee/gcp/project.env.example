# The GCP project of the sealed nodes' runs, as $IT_HOME/gcp/project.env on the test host (gcp.env
# reads it; keep it out of the repository).
PROJECT=my-tee-project
PROJECT_NUMBER=123456789012
# The test host's public address: the only source the firewall admits to the nodes' mTLS API.
SERVER_IP=192.0.2.10
# Optional: REGION, ZONE (a TDX zone), BUCKET (default: $PROJECT-tee-images) and WORKLOAD_SA
# (default: mpc-workload@$PROJECT.iam.gserviceaccount.com).
