# The GCP settings of the sealed nodes' runs (docs/tee.md). Sourced by run.sh and gcp.sh.
#
# The project's own values are not in the repository: PROJECT, PROJECT_NUMBER and SERVER_IP come
# from project.env in the run state ($IT_HOME/gcp/project.env on the test host, /it/gcp/project.env
# in the gcloud container), or from the file GCP_PROJECT_ENV names. project.env.example shows it.
for project_env in "${GCP_PROJECT_ENV:-}" /it/gcp/project.env "${IT_HOME:-$HOME/eth-mpc-it}/gcp/project.env"; do
	if [ -n "$project_env" ] && [ -r "$project_env" ]; then
		# shellcheck source=project.env.example
		source "$project_env"
		break
	fi
done
: "${PROJECT:?no GCP project: set PROJECT, PROJECT_NUMBER and SERVER_IP in project.env (see project.env.example)}"
: "${PROJECT_NUMBER:?no PROJECT_NUMBER in project.env}"
: "${SERVER_IP:?no SERVER_IP in project.env}"
REGION="${REGION:-europe-west4}"
ZONE="${ZONE:-europe-west4-a}"
# Every resource is named or labeled from here, and nothing else in the project is touched.
LABEL=purpose=eth-mpc-signer-tee
BUCKET="${BUCKET:-$PROJECT-tee-images}"
KEYRING=eth-mpc-tee
POOL=mpc-tee
PROVIDER=attestation
WORKLOAD_SA="${WORKLOAD_SA:-mpc-workload@$PROJECT.iam.gserviceaccount.com}"
TAG=mpc-tee
MACHINE=c3-standard-4
# The gcloud CLI, pinned by digest (run.sh runs gcp.sh in it).
GCLOUD_IMAGE=gcr.io/google.com/cloudsdktool/google-cloud-cli:592.0.0-slim@sha256:8a50079dfc4b164aa5e83926bef5f9b305b93e80f82d40fabd836da4830dd08e
